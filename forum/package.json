{
  "name": "angryducks-forum",
  "private": true,
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 migrations apply angryducks-forum --local",
    "db:remote": "wrangler d1 migrations apply angryducks-forum --remote",
    "dev": "wrangler dev",
    "sync": "node scripts/sync-manifesto.mjs",
    "predeploy": "node scripts/sync-manifesto.mjs",
    "deploy": "wrangler deploy --var BUILD:$(git rev-parse --short HEAD)$(git diff --quiet HEAD -- . || echo -dirty) --var BUILT_AT:$(date -u +%Y-%m-%dT%H:%M:%SZ)",
    "test:unit": "node --test test/unit.test.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  }
}
